# ─── StickyPie admin console (run locally; keep off the public internet) ─────
# Copy to .env.local. With Supabase vars left empty the console runs in DEMO
# MODE against the shared local JSON store, and signs in with a password only.
#
# Point it at your DEV Supabase project while developing, and at the PROD
# project when managing the live store (see docs/SETUP.md → "Environments").

# Supabase (Project Settings → API). The ANON key only — the admin app never
# needs the service-role key: Row Level Security grants admins their powers.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Demo-mode admin password (used only while Supabase vars are empty).
ADMIN_DEV_PASSWORD=stickypie

# Storefront origin, for image previews inside the admin UI.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ─── Cloudflare R2: production image storage (free tier) ─────────────────────
# Create the bucket + token: Cloudflare dashboard → R2 → Create bucket, then
# "Manage API tokens" → Create token (Object Read & Write, this bucket).
# R2_PUBLIC_URL = the bucket's public r2.dev URL, or your own domain
# (e.g. https://images.yourdomain.com) connected to the bucket.
# When these are set, admin uploads go to R2 (takes priority over Supabase
# Storage and the local folder).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stickypie-images
R2_PUBLIC_URL=

# Demo mode only — where image uploads land (default: ../web/public/stickers)
# UPLOAD_DIR=
# Demo mode only — the shared JSON store (default: ../../data/dev-store.json)
# DATA_FILE=

# Shiprocket (optional) — "Package ready → create shipment" on the order page.
# Create an API user in Shiprocket → Settings → API (not your login), and use
# the nickname of your pickup address (Settings → Pickup Addresses).
# SHIPROCKET_EMAIL=byteflowtechllp@gmail.com
# SHIPROCKET_PASSWORD=TrfSf!Ms#Jonz5JvIDet4Fgq^lKpWebQ
# SHIPROCKET_PICKUP_LOCATION=Primary

