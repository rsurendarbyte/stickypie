{
  "id": "/",
  "name": "StickyPie — Stickers & Wall Posters",
  "short_name": "StickyPie",
  "description": "AI stickers, die-cut vinyl stickers and wall posters, shipped across India.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": [
    "shopping",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://stickypie.in/manifest.webmanifest"
    },
    {
      "platform": "webapp",
      "url": "https://dev.stickypie.in/manifest.webmanifest"
    }
  ]
}
