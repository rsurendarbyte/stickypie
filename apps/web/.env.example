# ─── StickyPie storefront ────────────────────────────────────────────────────
# Copy to .env.local for local dev. With everything left empty the app runs in
# DEMO MODE: local JSON catalog + built-in payment simulator (no accounts needed).
#
# DEV  → use your *dev* Supabase project + Cashfree *sandbox* keys here.
# PROD → set the same variables on your host (e.g. Vercel) with the *prod*
#        Supabase project + Cashfree *production* keys. See docs/SETUP.md.

# Supabase (Project Settings → API). The service-role key is SERVER-ONLY:
# it stays in this app's server env and must never be exposed to browsers
# or committed to git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public (browser) Supabase access — lets the static pages refresh the catalog
# live from the Supabase API with no server involved. Anon key only (safe:
# RLS exposes just active products & categories). Needed at BUILD time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cashfree Payments (merchant dashboard → Developers → API keys)
# CASHFREE_ENV: sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Public URL of this storefront (used for payment return URLs & webhooks).
# Dev: http://localhost:3000 · Prod: https://yourdomain.com
SITE_URL=http://localhost:3000

# Demo mode only: where the local JSON store lives (default: ../../data/dev-store.json)
# DATA_FILE=

# Shiprocket tracking webhook (optional): the same token you enter in
# Shiprocket → Settings → API → Webhooks; set it as a Worker secret too:
#   npx wrangler secret put SHIPROCKET_WEBHOOK_TOKEN [--env production]
# Webhook URL: https://<your-domain>/api/webhooks/courier
# SHIPROCKET_WEBHOOK_TOKEN=
